      "safety_surface": {
        "threat_surfaces": ["action", "policy"],
        "sensitive_data_touchpoints": [],
        "externality_level": "local_only",
        "reversibility_confidence": "draft_only",
        "operator_attention_required": true
      },
      "learning_profile": {
