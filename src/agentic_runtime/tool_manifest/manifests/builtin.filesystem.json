        "useful_for_training_data": false
      },
      "prediction_required": false,
      "prediction_observable": true,
      "predicted_effect_quality": "seed"
    },
    {
      "tool_id": "builtin.write_file_draft",
      "plugin_id": "builtin.filesystem",
      "name": "Write File Draft",
      "description": "Declarative capability to prepare a proposed file change as draft/diff only. No file is written to disk in P1.3.8.",
      "category": "filesystem",
      "capability_types": ["write", "propose"],
      "input_schema": {
        "type": "object",
        "properties": {
          "path": {"type": "string"},
          "content": {"type": "string"}
        },
        "required": ["path", "content"]
      },
      "output_schema": {"type": "object"},
      "side_effects": ["state_change"],
      "risk_class": "R2",
      "reversibility": "draft_only",
      "requires_approval": false,
      "permissions_required": ["filesystem.write"],
      "data_access": ["local_project"],
      "execution_environment": "runtime",
      "dry_run_supported": true,
      "simulation_supported": true,
      "predicted_effect": {
        "state_target": "file:path",
        "expected_delta": "draft_diff_created",
        "affected_objects": ["draft:path", "file:path"],
        "reversible": true,
        "confidence_seed": "medium"
      },
      "failure_modes": ["path_not_found", "invalid_diff", "encoding_error"],
      "evidence_required": false,
      "trace_level": "standard",
      "timeout_policy": null,
      "rate_limit_policy": null,
      "enabled": true,
      "tool_roles": ["action"],
      "state_delta_contract": {
        "delta_type": "local_state_change",
        "affected_objects": ["draft:path", "file:path"],
