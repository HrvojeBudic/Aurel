{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Aurel Shell Desktop Wrapper",
  "version": "0.0.0-p210c",
  "identifier": "com.aurel.shell.desktop.wrapper",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173/?desktop=1",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Aurel Shell Desktop Wrapper (P2.10-C)",
        "width": 1280,
        "height": 840,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
